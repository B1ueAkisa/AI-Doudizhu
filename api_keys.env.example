# ============================================================
# AI 斗地主竞技场 - API 密钥配置模板
# 复制本文件为 api_keys.env 并填入你的真实密钥即可运行
# ============================================================

# 智谱开放平台 API Key (用于 GLM-4-Flash, GLM-Z1-Flash)
ZHIPU_API_KEY=your_zhipu_api_key_here

# 硅基流动 SiliconFlow API Key (用于 Qwen/Qwen2.5-7B-Instruct 等)
SILICONFLOW_API_KEY=your_siliconflow_api_key_here

# Google Gemini API Key (可选，用于裁判与解说自动生成)
GEMINI_API_KEY=your_gemini_api_key_here

# 代理配置 (如果调用需要科学上网的 API)
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
